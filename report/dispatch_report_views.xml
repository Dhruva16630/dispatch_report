<odoo>

    <record id="view_dispatch_report_list" model="ir.ui.view">
        <field name="name">dispatch.report.list</field>
        <field name="model">dispatch.report</field>
        <field name="arch" type="xml">
            <list string="Dispatch Report">
                <field name="product_id"/>
                <field name="quantity_delivered"/>
                <field name="total_demand"/>
                <field name="quantity_to_deliver"/>
                <field name="uom"/>
                <field name="hsn_code"/>
                <field name="barcode"/>
                <field name="fiscal_position"/>
                <field name="payment_terms" optional = "hide"/>
                <field name="internal_reference"/>
                <field name="scheduled_date"/>
            </list>
        </field>
    </record>


    <record id="action_dispatch_report" model="ir.actions.act_window">
        <field name="name">Dispatch Report</field>
        <field name="res_model">dispatch.report</field>
        <field name="view_mode">list</field>
    </record>


    <menuitem
        id="menu_dispatch_report"
        name="Dispatch Report"
        parent="stock.menu_stock_root"
        action="action_dispatch_report"
        sequence="50"
    />

</odoo>